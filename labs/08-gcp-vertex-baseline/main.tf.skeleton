# Secure Vertex AI baseline - SKELETON. Copy to main.tf and fill the TODOs.
# This lab is PLAN-ONLY by default: you run `terraform validate` and `terraform plan`, not apply.
# That exercises the design and policy checks without spending money or needing a real project.

terraform {
  required_providers {
    google = { source = "hashicorp/google", version = "~> 6.0" }
  }
}

variable "project_id" { type = string }
variable "region" { type = string, default = "europe-west2" }

provider "google" {
  project = var.project_id
  region  = var.region
}

