# Copy to labs/.env and fill in. labs/.env is git-ignored. Never commit real keys.

# Gemini API key from https://aistudio.google.com/apikey (free tier)
GOOGLE_API_KEY=paste-your-key-here

# Use the Gemini API (AI Studio), not Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Model for every lab. "gemini-flash-latest" always points at the current free Flash model.
GEMINI_MODEL=gemini-flash-latest
