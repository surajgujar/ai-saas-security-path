# Copy to labs/.env and fill in. labs/.env is git-ignored. Never commit real keys.

# Which model backend the labs use: aistudio (default, free) | vertex | claude
LAB_MODEL_BACKEND=aistudio

# ---- aistudio: Gemini API key, free tier (the default, simplest, $0) ----
# Key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-flash-latest

# ---- vertex: Vertex AI via Application Default Credentials (no key in this file) ----
# Set LAB_MODEL_BACKEND=vertex above, uncomment these, and run:
#   gcloud auth application-default login
# Vertex is paid (new accounts get trial credit). On Vertex use a versioned model id,
# e.g. gemini-2.5-flash, because the "-latest" alias may not resolve there.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=europe-west2
# GEMINI_MODEL=gemini-2.5-flash

# ---- claude: Claude via ADK's LiteLlm wrapper ----
# Set LAB_MODEL_BACKEND=claude above, run: uv add "google-adk[extensions]"
# Key from https://console.anthropic.com/ . Paid (no free tier).
# CLAUDE_MODEL is in litellm format "anthropic/<model-id>". Default is the cheapest (Haiku).
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=anthropic/claude-haiku-5-5
